# Copier ce fichier en ".env" et remplir les valeurs (le .env réel n'est jamais commité, voir .gitignore)

# Clé secrète Django - à générer, ne jamais utiliser une valeur par défaut en production
# Génération rapide : python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits+'!@#$%^&*(-_=+)') for _ in range(50)))"
SECRET_KEY=change-me-please-generate-a-real-secret-key

# Clé API Mistral (utilisée dans ai/services.py pour le Barista IA)
MISTRAL_API_KEY=

# Mode debug - toujours False en production
DEBUG=True
